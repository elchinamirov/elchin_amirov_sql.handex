--TRIM,LTRIM,RTRIM,--LEADING,TRAILING,BOTH
 select '   SQL     ', trim('      SQL     ') from dual
 
 select '*****SQL*****',
 trim(leading '*' from '******SQL*******'),
 trim (trailing '*' from '******SQL***PL**'),
 trim (both '*' from '******SQL******'),
 ltrim('****###!SQL****###!*','*#'),
 rtrim(ltrim('****###SQL****###*','*#'),'*#')

  from dual

