---SYSDATE
select sysdate,
       sysdate+10,
       sysdate-5,
       sysdate+2/24,
       sysdate+30/24/60/60
 from dual
 
 
 select first_name,
        round((sysdate-hire_date)/365,1) as staj,
        case when round((sysdate-hire_date)/365,1)<=30 then '30-a qeder'
             when round((sysdate-hire_date)/365,1)>30 and round((sysdate-hire_date)/365,1)<=40 then '30-40'
               else '40+'
           end as staj_bolgu
   from employees;

